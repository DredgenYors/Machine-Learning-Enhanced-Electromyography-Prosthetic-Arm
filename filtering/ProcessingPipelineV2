    def extract_features_from_window(self, window_data, zc_threshold=0.01, ssc_threshold=0.01):
        """
        Extract all 5 features from a single window.
        
        Parameters:
        window_data: numpy array, EMG signal window (samples x channels)
        zc_threshold: float, threshold for zero crossings
        ssc_threshold: float, threshold for slope sign changes
        
        Returns:
        dict: Dictionary containing all extracted features
        """
        if window_data.ndim == 1:
            window_data = window_data[:, np.newaxis]
        
        n_channels = window_data.shape[1]
        features = {
            'RMS': [],
            'MAV': [],
            'ZC': [],
            'SSC': [],
            'WL': []
        }
        
        # Extract features for each channel
        for ch in range(n_channels):
            channel_data = window_data[:, ch]
            
            features['RMS'].append(self.extract_rms(channel_data))
            features['MAV'].append(self.extract_mav(channel_data))
            features['ZC'].append(self.extract_zc(channel_data, zc_threshold))
            features['SSC'].append(self.extract_ssc(channel_data, ssc_threshold))
            features['WL'].append(self.extract_wl(channel_data))
        
        return features
    
    def extract_windowed_features_optimal(self, window_size=None, overlap=None, 
                                     zc_threshold=0.01, ssc_threshold=0.01):
        """
        Extract features with optimal pipeline stages (Option 1):
        - ZC and SSC: Extract from pre-rectification signal (preserves bipolar nature)
        - RMS, MAV & WL: Extract from post-rectification signal (better amplitude features)
        This approach maximizes feature quality by extracting each feature at the 
        most appropriate stage of the signal processing pipeline.
        """
        if self.original_signal is None:
            print("No signal loaded. Please load a file first.")
            return None

        # Use provided parameters or defaults
        if window_size is None:
            window_size = self.window_size
        if overlap is None:
            overlap = self.overlap

        step_size = int(window_size * (1 - overlap))
        channels = self.selected_channels if self.selected_channels is not None else list(range(self.original_signal.shape[1]))
        n_samples = self.original_signal.shape[0]
        n_channels = len(channels)

        # --- NEW: Detect if signal is already rectified ---
        orig = self.original_signal[:, channels]
        min_val = np.min(orig)
        rectified_detected = min_val >= 0 and np.mean(orig < 0) < 0.01  # Allow for tiny negative noise

        if rectified_detected:
            print("\n  Detected that raw EMG appears to be rectified (all values ≥ 0).")
            print("    Skipping bandpass and rectification. Only applying notch, DC removal, and low-pass envelope.")
            # Stage 1: Pre-rectification (for ZC/SSC) is not meaningful, so fill with zeros
            pre_rect_signal = np.zeros_like(orig)
            # Stage 2: Post-rectification: apply notch, DC removal, low-pass
            from scipy.signal import butter, filtfilt, iirnotch
            # Notch filter (50 Hz)
            b, a = iirnotch(50, 30, self.fs)
            post_rect_signal = filtfilt(b, a, orig, axis=0)
            # DC removal
            post_rect_signal = post_rect_signal - np.mean(post_rect_signal, axis=0)
            # Low-pass envelope filter (6 Hz)
            nyq = 0.5 * self.fs
            normal_cutoff = min(6.0 / nyq, 0.99)
            b, a = butter(4, normal_cutoff, btype='low')
            post_rect_signal = filtfilt(b, a, post_rect_signal, axis=0)
        else:
            # --- Standard pipeline as before ---
            print(f"\nExtracting features with OPTIMAL pipeline stages:")
            print(f"  ZC & SSC: From pre-rectification signal (preserves bipolar crossings)")
            print(f"  RMS, MAV & WL: From post-rectification signal (better amplitude features)")
            print(f"  Window size: {window_size} samples ({window_size/self.fs:.3f} seconds)")
            print(f"  Overlap: {overlap*100:.0f}%")
            print(f"  Step size: {step_size} samples ({step_size/self.fs:.3f} seconds)")

            # Prepare signals at different processing stages
            # Stage 1: Pre-rectification (for ZC and SSC)
            pre_rect_signal = orig.copy()
            from scipy.signal import butter, filtfilt, iirnotch
            # Bandpass filter (20-500 Hz)
            nyq = 0.5 * self.fs
            low = 20.0 / nyq
            high = min(500.0 / nyq, 0.99)
            b, a = butter(4, [low, high], btype='band')
            pre_rect_signal = filtfilt(b, a, pre_rect_signal, axis=0)
            # Notch filter (50 Hz)
            b, a = iirnotch(50, 30, self.fs)
            pre_rect_signal = filtfilt(b, a, pre_rect_signal, axis=0)
            # DC removal
            pre_rect_signal = pre_rect_signal - np.mean(pre_rect_signal, axis=0)
            # Stage 2: Post-rectification (for RMS, MAV, WL)
            post_rect_signal = np.abs(pre_rect_signal)  # Apply rectification
            # Low-pass envelope filter (6 Hz)
            normal_cutoff = min(6.0 / nyq, 0.99)
            b, a = butter(4, normal_cutoff, btype='low')
            post_rect_signal = filtfilt(b, a, post_rect_signal, axis=0)

            print(f"   Pre-rectification signal prepared (range: {np.min(pre_rect_signal):.4f} to {np.max(pre_rect_signal):.4f})")
            print(f"   Post-rectification signal prepared (range: {np.min(post_rect_signal):.4f} to {np.max(post_rect_signal):.4f})")

        # --- The rest of your feature extraction code remains unchanged ---
        # Initialize feature storage
        rms_values = []
        mav_values = []
        zc_values = []
        ssc_values = []
        wl_values = []
        window_centers = []

        window_count = 0
        for start in range(0, n_samples - window_size + 1, step_size):
            end = start + window_size
            pre_rect_window = pre_rect_signal[start:end, :]
            post_rect_window = post_rect_signal[start:end, :]

            # Extract ZC and SSC from pre-rectification signal (skip if rectified)
            zc_features = []
            ssc_features = []
            if rectified_detected:
                zc_features = [0] * n_channels
                ssc_features = [0] * n_channels
            else:
                for ch in range(n_channels):
                    zc_features.append(self.extract_zc(pre_rect_window[:, ch], zc_threshold))
                    ssc_features.append(self.extract_ssc(pre_rect_window[:, ch], ssc_threshold))

            # Extract RMS, MAV, WL from post-rectification signal
            rms_features = []
            mav_features = []
            wl_features = []
            for ch in range(n_channels):
                rms_features.append(self.extract_rms(post_rect_window[:, ch]))
                mav_features.append(self.extract_mav(post_rect_window[:, ch]))
                wl_features.append(self.extract_wl(post_rect_window[:, ch]))

            # Store features
            rms_values.append(rms_features)
            mav_values.append(mav_features)
            zc_values.append(zc_features)
            ssc_values.append(ssc_features)
            wl_values.append(wl_features)
            window_centers.append(start + window_size // 2)
            window_count += 1

        # Convert to numpy arrays
        self.extracted_features = {
            'RMS': np.array(rms_values),
            'MAV': np.array(mav_values),
            'ZC': np.array(zc_values),
            'SSC': np.array(ssc_values),
            'WL': np.array(wl_values)
        }

        self.window_centers = np.array(window_centers)

        # Create feature matrix (n_windows x n_features)
        feature_list = []
        for feature_name in ['RMS', 'MAV', 'ZC', 'SSC', 'WL']:
            feature_list.append(self.extracted_features[feature_name])
        self.feature_matrix = np.concatenate(feature_list, axis=1)

        print(f"   Extracted OPTIMAL features from {window_count} windows")
        print(f"  Feature matrix shape: {self.feature_matrix.shape} (windows x features)")
        print(f"  Features per window: {self.feature_matrix.shape[1]} ({n_channels} channels x 5 features)")

        # Print feature quality summary
        print(f"\n  FEATURE QUALITY SUMMARY:")
        for feature_name in ['ZC', 'SSC']:
            values = self.extracted_features[feature_name]
            non_zero_pct = np.mean(values > 0) * 100
            print(f"    {feature_name}: {non_zero_pct:.1f}% of windows have non-zero values")
            print(f"         Range: [{np.min(values):.0f}, {np.max(values):.0f}], Mean: {np.mean(values):.2f}")

        return {
            'features': self.extracted_features,
            'feature_matrix': self.feature_matrix,
            'window_centers': self.window_centers,
            'window_count': window_count,
            'window_size': window_size,
            'overlap': overlap,
            'extraction_method': 'optimal_dual_stage'
        }
    
    def extract_windowed_features(self, signal=None, window_size=None, overlap=None, 
                                zc_threshold=0.01, ssc_threshold=0.01):
        """
        Extract features from overlapping windows of the signal (legacy method).
        
        NOTE: This is the original single-stage extraction method. For better feature quality,
        use extract_windowed_features_optimal() which extracts ZC/SSC before rectification
        and RMS/MAV/WL after rectification.
        
        Parameters:
        signal: numpy array, EMG signal (if None, uses filtered_signal)
        window_size: int, window size in samples (if None, uses default)
