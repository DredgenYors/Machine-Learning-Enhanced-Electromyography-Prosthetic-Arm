    def _validate_feature_values(self):
        """Check if feature values are within expected ranges."""
        feature_names = ['RMS', 'MAV', 'ZC', 'SSC', 'WL']
        
        for feature_name in feature_names:
            values = self.extracted_features[feature_name]
            
            # Basic validation
            has_nan = np.isnan(values).sum()
            has_inf = np.isinf(values).sum()
            has_negative = (values < 0).sum()
            
            print(f"   {feature_name}:")
            print(f"     Shape: {values.shape}")
            print(f"     Range: [{np.min(values):.4f}, {np.max(values):.4f}]")
            print(f"     Mean: {np.mean(values):.4f} ± {np.std(values):.4f}")
            
            if has_nan > 0:
                print(f"       {has_nan} NaN values detected")
            if has_inf > 0:
                print(f"       {has_inf} infinite values detected")
            if has_negative > 0 and feature_name in ['RMS', 'MAV', 'WL']:
                print(f"       {has_negative} negative values (should be positive)")
            
            # Feature-specific validation
            if feature_name in ['ZC', 'SSC']:
                non_zero_pct = np.mean(values > 0) * 100
                print(f"     Non-zero windows: {non_zero_pct:.1f}%")
                if non_zero_pct < 10:
                    print(f"       Very few non-zero values - possible extraction issue")
                elif non_zero_pct > 50:
                    print(f"      Good activity detection")
            print()
    
    def _analyze_feature_distributions(self):
        """Analyze statistical distributions of features."""
        feature_names = ['RMS', 'MAV', 'ZC', 'SSC', 'WL']
        
        for feature_name in feature_names:
            values = self.extracted_features[feature_name].flatten()
            
            # Calculate distribution metrics
            mean_val = np.mean(values)
            median_val = np.median(values)
            std_val = np.std(values)
            skewness = np.mean(((values - mean_val) / std_val) ** 3)
            
            # Calculate coefficient of variation
            cv = (std_val / mean_val) * 100 if mean_val != 0 else 0
            
            print(f"   {feature_name}: Mean/Median: {mean_val:.4f}/{median_val:.4f}, ")
            print(f"             Skewness: {skewness:.2f}, CV: {cv:.1f}%")
    
    def _analyze_feature_correlations(self):
        """Analyze correlations between different features."""
        if self.feature_matrix is None:
            print("   No feature matrix available")
            return
        
        # Calculate correlation matrix
        corr_matrix = np.corrcoef(self.feature_matrix.T)
        feature_names = ['RMS', 'MAV', 'ZC', 'SSC', 'WL']
        
        print(f"   Feature correlation matrix (first channel):")
        print(f"   {'':>8} ", end="")
        for name in feature_names:
            print(f"{name:>8}", end="")
        print()
        
        n_features_per_channel = len(feature_names)
        for i, name1 in enumerate(feature_names):
            print(f"   {name1:>8} ", end="")
            for j, name2 in enumerate(feature_names):
                corr_val = corr_matrix[i, j]
                print(f"{corr_val:8.3f}", end="")
            print()
        
        # Highlight strong correlations
        strong_corr = []
        for i in range(n_features_per_channel):
            for j in range(i+1, n_features_per_channel):
                corr_val = abs(corr_matrix[i, j])
                if corr_val > 0.8:
                    strong_corr.append((feature_names[i], feature_names[j], corr_matrix[i, j]))
        
        if strong_corr:
            print(f"\n   Strong correlations (|r| > 0.8):")
            for feat1, feat2, corr in strong_corr:
                print(f"     {feat1} - {feat2}: {corr:.3f}")
    
    def _validate_physiological_features(self):
        """Check if features make physiological sense for EMG."""
        
        # Expected relationships for EMG
