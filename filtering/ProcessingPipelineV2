    def get_exercise_name(self):
        """Return the exercise name for the loaded exercise number."""
        if self.exercise is not None:
            try:
                # If exercise is an array, get the scalar value
                ex_num = int(np.squeeze(self.exercise))
                return self.EXERCISE_LABELS.get(ex_num, f"Unknown ({ex_num})")
            except Exception:
                return "Invalid exercise value"
