    """
    Complete EMG filtering and feature extraction pipeline with:
    
    5 Filter Types:
    1. Bandpass filter (20-500 Hz)
    2. Notch filter (50-60 Hz) 
    3. DC offset removal (mean subtraction)
    4. Rectification (absolute value)
    5. Low-pass envelope filter (2-6 Hz)
    
    5 Feature Types:
    1. RMS (Root Mean Square) - Signal magnitude
    2. MAV (Mean Absolute Value) - Average amplitude
    3. ZC (Zero Crossings) - Count of oscillations around zero
    4. SSC (Slope Sign Changes) - Count of slope direction changes
    5. WL (Waveform Length) - Total signal variation over time window
    """
    
    def __init__(self, fs=1000):
        """
        Initialize the filtering and feature extraction pipeline.
        Parameters:
        fs: int, sampling frequency in Hz
        """
        self.fs = fs
        self.filtered_signal = None
        self.filter_history = []
        self.num_channels = 0
        self.exercise = None  # Stores movement classification labels if available
        self.selected_channels = None  # List of selected channel indices
        # Feature extraction variables
        self.extracted_features = None
        self.feature_matrix = None
        self.window_centers = None
        self.window_size = 250  # Default window size (250ms at 1000Hz)
        self.overlap = 0.5      # Default 50% overlap
        
    def load_matlab_file(self):
        """Load EMG data from MATLAB file."""
        print("EMG Filtering Pipeline")
        print("=" * 50)
        
        # File selection
        Tk().withdraw()  # Hide the root Tk window
        mat_file = askopenfilename(title="Select a MATLAB .mat file",
                                   filetypes=[("MAT files", "*.mat")])
        
        if not mat_file:
            raise ValueError("No file selected. Exiting.")
        
        print(f"Selected file: {mat_file}")
        
        # Load MATLAB file
        try:
            mat = scipy.io.loadmat(mat_file)
            emg = np.squeeze(mat['emg'])  # Load EMG data
            print(f"Loaded EMG data with shape: {emg.shape}")
            # Try to load exercise variable if present
            if 'exercise' in mat:
                self.exercise = np.squeeze(mat['exercise'])
                print(f"Loaded exercise variable: {self.exercise}")
                ex_name = self.get_exercise_name()
                print(f"Exercise label: {ex_name}")
            else:
                self.exercise = None
                print("No 'exercise' variable found in file.")
        except Exception as e:
            print(f"Error loading file: {e}")
            return None
        
        # Handle multi-channel data
        if emg.ndim > 1:
            print(f"Multi-channel EMG detected: {emg.shape[1]} channels")
            self.original_signal = emg
            self.num_channels = emg.shape[1]
        else:
            print("Single-channel EMG detected")
            self.original_signal = emg[:, np.newaxis]
            self.num_channels = 1
        
        # Initialize filtered signal as copy of original
        self.filtered_signal = self.original_signal.copy()

        # Prompt user to select channels
        self.selected_channels = self.prompt_channel_selection()
        print(f"Selected channels: {self.selected_channels}")
        
        print(f"Signal shape: {self.original_signal.shape} (samples x channels)")
        print(f"Signal range: {np.min(self.original_signal):.6f} to {np.max(self.original_signal):.6f}")
        print(f"Sampling frequency: {self.fs} Hz")
        
        return True

    def prompt_channel_selection(self):
        """Prompt user to select channels to process."""
        if self.num_channels == 1:
            return [0]
        print(f"\nAvailable channels: 0 to {self.num_channels-1}")
        print("Enter channel numbers separated by commas (e.g., 0,2,4) or 'all' for all channels:")
        while True:
            user_input = input("Channels to use: ").strip()
            if user_input.lower() == 'all':
                return list(range(self.num_channels))
            try:
                channels = [int(x) for x in user_input.split(',') if x.strip().isdigit()]
                if all(0 <= ch < self.num_channels for ch in channels) and channels:
                    return channels
                else:
                    print(f"Invalid input. Please enter valid channel numbers between 0 and {self.num_channels-1}.")
            except Exception:
                print("Invalid input. Please enter channel numbers separated by commas or 'all'.")
    
    def bandpass_filter(self, lowcut=20, highcut=500, order=4):
        """
        Apply bandpass filter to remove baseline drift and high-frequency noise.
        
        Parameters:
        lowcut: float, low cutoff frequency (Hz)
        highcut: float, high cutoff frequency (Hz) 
        order: int, filter order
        """
        print(f"\nApplying bandpass filter ({lowcut}-{highcut} Hz, order {order})...")
        
        # Design filter
        nyq = 0.5 * self.fs
        low = lowcut / nyq
        high = highcut / nyq
        
        if high >= 1.0:
            high = 0.99  # Prevent filter design issues
            print(f"  Warning: High cutoff adjusted to {high * nyq:.1f} Hz")
        
        b, a = butter(order, [low, high], btype='band')
        
        # Apply filter
        try:
            # Only filter selected channels
            if self.selected_channels is not None:
                filtered = self.filtered_signal.copy()
                filtered[:, self.selected_channels] = filtfilt(b, a, filtered[:, self.selected_channels], axis=0)
                self.filtered_signal = filtered
            else:
                self.filtered_signal = filtfilt(b, a, self.filtered_signal, axis=0)
            self.filter_history.append(f"Bandpass {lowcut}-{highcut} Hz")
            
            print(f"   Bandpass filter applied successfully")
            print(f"  Signal range after filtering: {np.min(self.filtered_signal):.6f} to {np.max(self.filtered_signal):.6f}")
            
        except Exception as e:
            print(f"   Error applying bandpass filter: {e}")
    
    def notch_filter(self, notch_freq=50, quality_factor=30):
        """
        Apply notch filter to remove power line interference.
        
        Parameters:
        notch_freq: float, frequency to notch out (Hz) - 50 Hz Europe, 60 Hz US
        quality_factor: float, Q factor (higher = narrower notch)
        """
        print(f"\nApplying notch filter ({notch_freq} Hz, Q={quality_factor})...")
        
        try:
            # Design notch filter
            b, a = iirnotch(notch_freq, quality_factor, self.fs)
            
            # Apply filter
            if self.selected_channels is not None:
                filtered = self.filtered_signal.copy()
                filtered[:, self.selected_channels] = filtfilt(b, a, filtered[:, self.selected_channels], axis=0)
                self.filtered_signal = filtered
            else:
                self.filtered_signal = filtfilt(b, a, self.filtered_signal, axis=0)
            self.filter_history.append(f"Notch {notch_freq} Hz")
            
            print(f"   Notch filter applied successfully")
            print(f"  Signal range after filtering: {np.min(self.filtered_signal):.6f} to {np.max(self.filtered_signal):.6f}")
            
        except Exception as e:
            print(f"   Error applying notch filter: {e}")
    
    def dc_removal_filter(self):
        """
        Remove DC offset by subtracting the mean.
        """
        print(f"\nApplying DC offset removal (mean subtraction)...")
        
        try:
            # Calculate and subtract mean for each selected channel
            filtered = self.filtered_signal.copy()
            if self.selected_channels is not None:
                dc_offset = np.mean(filtered[:, self.selected_channels], axis=0)
                filtered[:, self.selected_channels] = filtered[:, self.selected_channels] - dc_offset
            else:
                dc_offset = np.mean(filtered, axis=0)
                filtered = filtered - dc_offset
            self.filtered_signal = filtered
            self.filter_history.append("DC removal")
            
            print(f"   DC offset removed successfully")
            print(f"  DC offset values: {dc_offset}")
            print(f"  Signal range after filtering: {np.min(self.filtered_signal):.6f} to {np.max(self.filtered_signal):.6f}")
            
        except Exception as e:
            print(f"   Error applying DC removal: {e}")
    
    def rectification_filter(self):
        """
        Apply rectification (absolute value) to get signal envelope.
        """
        print(f"\nApplying rectification (absolute value)...")
        
        try:
            filtered = self.filtered_signal.copy()
            if self.selected_channels is not None:
                filtered[:, self.selected_channels] = np.abs(filtered[:, self.selected_channels])
            else:
                filtered = np.abs(filtered)
            self.filtered_signal = filtered
            self.filter_history.append("Rectification")
            
            print(f"   Rectification applied successfully")
            print(f"  Signal range after filtering: {np.min(self.filtered_signal):.6f} to {np.max(self.filtered_signal):.6f}")
            
        except Exception as e:
            print(f"   Error applying rectification: {e}")
    
    def lowpass_envelope_filter(self, cutoff=6, order=4):
        """
        Apply low-pass filter for envelope detection.
        
        Parameters:
        cutoff: float, cutoff frequency (Hz)
        order: int, filter order
        """
        print(f"\nApplying low-pass envelope filter ({cutoff} Hz, order {order})...")
        
        try:
            # Design filter
            nyq = 0.5 * self.fs
            normal_cutoff = cutoff / nyq
            
            if normal_cutoff >= 1.0:
                normal_cutoff = 0.99
                print(f"  Warning: Cutoff adjusted to {normal_cutoff * nyq:.1f} Hz")
            
            b, a = butter(order, normal_cutoff, btype='low')
            
            # Apply filter
            filtered = self.filtered_signal.copy()
            if self.selected_channels is not None:
                filtered[:, self.selected_channels] = filtfilt(b, a, filtered[:, self.selected_channels], axis=0)
            else:
                filtered = filtfilt(b, a, filtered, axis=0)
            self.filtered_signal = filtered
            self.filter_history.append(f"Low-pass {cutoff} Hz")
            
            print(f"  Low-pass filter applied successfully")
            print(f"  Signal range after filtering: {np.min(self.filtered_signal):.6f} to {np.max(self.filtered_signal):.6f}")
            
        except Exception as e:
            print(f"   Error applying low-pass filter: {e}")

