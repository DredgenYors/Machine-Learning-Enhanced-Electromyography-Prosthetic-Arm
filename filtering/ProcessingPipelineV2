    def _assess_feature_quality(self):
        """Assess overall quality of extracted features."""
        feature_names = ['RMS', 'MAV', 'ZC', 'SSC', 'WL']
        quality_scores = {}
        
        for feature_name in feature_names:
            values = self.extracted_features[feature_name].flatten()
            
            # Quality metrics
            dynamic_range = np.max(values) - np.min(values)
            cv = (np.std(values) / np.mean(values)) * 100 if np.mean(values) > 0 else 0
            non_zero_pct = np.mean(values > 0) * 100
            
            # Calculate quality score (0-100)
            score = 0
            
            # Dynamic range score (0-30 points)
            if dynamic_range > 0:
                score += min(30, dynamic_range * 10)
            
            # Variability score (0-30 points) - good features have moderate CV
            if 10 <= cv <= 100:
                score += 30
            elif cv > 0:
                score += max(0, 30 - abs(cv - 50) / 2)
            
            # Activity score (0-40 points)
            if feature_name in ['ZC', 'SSC']:
                # For counting features, non-zero percentage is important
                score += min(40, non_zero_pct * 0.8)
            else:
                # For amplitude features, non-zero should be 100%
                if non_zero_pct > 95:
                    score += 40
                else:
                    score += non_zero_pct * 0.4
            
            quality_scores[feature_name] = min(100, score)
        
        print(f"   Feature Quality Scores (0-100):")
        for feature_name, score in quality_scores.items():
            quality = "Excellent" if score >= 80 else "Good" if score >= 60 else "Fair" if score >= 40 else "Poor"
            print(f"     {feature_name}: {score:.1f} ({quality})")
        
        overall_score = np.mean(list(quality_scores.values()))
        overall_quality = "Excellent" if overall_score >= 80 else "Good" if overall_score >= 60 else "Fair" if overall_score >= 40 else "Poor"
        print(f"\n   Overall Feature Quality: {overall_score:.1f} ({overall_quality})")
    
