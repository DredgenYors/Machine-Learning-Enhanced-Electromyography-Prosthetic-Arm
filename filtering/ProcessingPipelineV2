        print("\n5. EMG-SPECIFIC VALIDATION:")
        self._validate_emg_characteristics()
    
    def _analyze_frequency_content(self):
        """Analyze frequency content before and after filtering."""
        from scipy.fft import fft, fftfreq
        
        # Analyze first channel only for clarity
        channel = 0
        if self.num_channels > 1:
            print(f"   Analyzing Channel 1 (of {self.num_channels} channels)")
        
        # Calculate FFT for original and filtered signals
        n_samples = min(8192, self.original_signal.shape[0])  # Limit for efficiency
        freqs = fftfreq(n_samples, 1/self.fs)[:n_samples//2]
        
        orig_fft = np.abs(fft(self.original_signal[:n_samples, channel]))[:n_samples//2]
        filt_fft = np.abs(fft(self.filtered_signal[:n_samples, channel]))[:n_samples//2]
        
        # Find dominant frequencies
        orig_peak_idx = np.argmax(orig_fft[1:]) + 1  # Skip DC
        filt_peak_idx = np.argmax(filt_fft[1:]) + 1  # Skip DC
        
        print(f"   Original signal dominant frequency: {freqs[orig_peak_idx]:.1f} Hz")
        print(f"   Filtered signal dominant frequency: {freqs[filt_peak_idx]:.1f} Hz")
        
        # Check energy in typical EMG bands
        emg_band = (freqs >= 20) & (freqs <= 500)
        noise_low = (freqs >= 1) & (freqs < 20)
        noise_high = (freqs > 500) & (freqs <= 1000)
        
        orig_emg_energy = np.sum(orig_fft[emg_band])
        orig_noise_low = np.sum(orig_fft[noise_low])
        orig_noise_high = np.sum(orig_fft[noise_high])
        
        filt_emg_energy = np.sum(filt_fft[emg_band])
        filt_noise_low = np.sum(filt_fft[noise_low])
        filt_noise_high = np.sum(filt_fft[noise_high])
        
        print(f"   Energy in EMG band (20-500 Hz):")
        print(f"     Original: {orig_emg_energy:.2e}, Filtered: {filt_emg_energy:.2e}")
        print(f"   Energy in low noise (<20 Hz):")
        print(f"     Original: {orig_noise_low:.2e}, Filtered: {filt_noise_low:.2e}")
        print(f"   Energy in high noise (>500 Hz):")
        print(f"     Original: {orig_noise_high:.2e}, Filtered: {filt_noise_high:.2e}")
        
        # Check filtering effectiveness
        if 'Bandpass' in ' '.join(self.filter_history):
            low_reduction = (1 - filt_noise_low/orig_noise_low) * 100 if orig_noise_low > 0 else 0
            high_reduction = (1 - filt_noise_high/orig_noise_high) * 100 if orig_noise_high > 0 else 0
            print(f"   Noise reduction: Low freq: {low_reduction:.1f}%, High freq: {high_reduction:.1f}%")
    
    def _verify_filter_effects(self):
        """Verify that each filter had the expected effect."""
        print(f"   Applied filters: {len(self.filter_history)}")
        
        for i, filter_name in enumerate(self.filter_history, 1):
            print(f"   {i}. {filter_name}")
        
        # Check rectification effect
        if 'Rectification' in self.filter_history:
            min_val = np.min(self.filtered_signal)
            if min_val >= 0:
                print("    Rectification verified: All values ≥ 0")
            else:
                print(f"     Rectification issue: Found negative value {min_val:.6f}")
        
        # Check DC removal effect
        if 'DC removal' in self.filter_history:
            mean_val = np.mean(self.filtered_signal)
            if abs(mean_val) < 1e-10:
                print(f"    DC removal verified: Mean ≈ 0 ({mean_val:.2e})")
            else:
                print(f"     DC removal issue: Mean = {mean_val:.6f}")
    
    def _compare_signal_statistics(self):
        """Compare statistical properties of original vs filtered signals."""
        orig_stats = {
            'Mean': np.mean(self.original_signal),
            'Std': np.std(self.original_signal),
            'Min': np.min(self.original_signal),
            'Max': np.max(self.original_signal),
            'RMS': np.sqrt(np.mean(self.original_signal**2))
        }
        
        filt_stats = {
            'Mean': np.mean(self.filtered_signal),
            'Std': np.std(self.filtered_signal),
            'Min': np.min(self.filtered_signal),
            'Max': np.max(self.filtered_signal),
            'RMS': np.sqrt(np.mean(self.filtered_signal**2))
        }
        
        print(f"   {'Statistic':<10} {'Original':<12} {'Filtered':<12} {'Change':<10}")
        print(f"   {'-'*50}")
        
        for stat in orig_stats.keys():
            orig_val = orig_stats[stat]
            filt_val = filt_stats[stat]
            change = ((filt_val - orig_val) / orig_val * 100) if orig_val != 0 else 0
            print(f"   {stat:<10} {orig_val:<12.4f} {filt_val:<12.4f} {change:+7.1f}%")
    
    def _validate_emg_characteristics(self):
        """Validate that signal still has EMG-like characteristics."""
        # Check signal amplitude (typical EMG range: 0.01-10 mV)
        signal_range = np.max(self.filtered_signal) - np.min(self.filtered_signal)
        rms_value = np.sqrt(np.mean(self.filtered_signal**2))
        
        print(f"   Signal range: {signal_range:.6f}")
        print(f"   RMS amplitude: {rms_value:.6f}")
        
        # Check for reasonable EMG characteristics
        if 'Rectification' in self.filter_history:
            # After rectification, should be all positive
            if np.min(self.filtered_signal) >= 0:
                print("    Rectified signal is all positive")
            else:
                print("     Rectified signal has negative values")
        
        # Check for signal activity (not flat)
        signal_activity = np.std(self.filtered_signal)
        if signal_activity > 1e-6:
            print(f"    Signal shows activity (std: {signal_activity:.6f})")
        else:
            print(f"     Signal appears flat (std: {signal_activity:.6f})")
    
