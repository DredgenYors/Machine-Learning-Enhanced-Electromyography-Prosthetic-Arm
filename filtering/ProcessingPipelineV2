        print(f"   Filtered signal shape: {self.filtered_signal.shape}")
        print(f"   Sampling frequency: {self.fs} Hz")
        print(f"   Signal duration: {self.original_signal.shape[0]/self.fs:.2f} seconds")
        
        # Check for NaN or infinite values
        orig_nan = np.isnan(self.original_signal).sum()
