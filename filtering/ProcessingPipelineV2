def batch_process_zip_of_mat_files(pipeline):
    print("\nSelect a ZIP file containing MATLAB .mat files...")
    print("Please enter the full path to your ZIP file (or leave blank to cancel): ")
    zip_path = input().strip()
    if not zip_path:
        print("No ZIP file provided. Cancelling batch process.")
        return
    extract_dir = "unzipped_matlab_files"
    if os.path.exists(extract_dir):
        shutil.rmtree(extract_dir)
    os.makedirs(extract_dir, exist_ok=True)
    with zipfile.ZipFile(zip_path, 'r') as zip_ref:
        zip_ref.extractall(extract_dir)
    print(f"Extracted all files to: {os.path.abspath(extract_dir)}")
    mat_files = glob.glob(os.path.join(extract_dir, '*.mat'))
    if not mat_files:
        print('No .mat files found in extracted directory.')
        return
    all_feature_dfs = []
    for mat_path in mat_files:
        print(f"Processing: {mat_path}")
        try:
            # Load .mat file into pipeline
            mat = scipy.io.loadmat(mat_path)
            emg = np.squeeze(mat['emg'])
            pipeline.original_signal = emg if emg.ndim > 1 else emg[:, np.newaxis]
            pipeline.num_channels = pipeline.original_signal.shape[1]
            pipeline.filtered_signal = pipeline.original_signal.copy()
            pipeline.selected_channels = list(range(pipeline.num_channels))
            pipeline.exercise = np.squeeze(mat['exercise']) if 'exercise' in mat else None
            # Apply complete pipeline and extract features
            pipeline.reset_signal()
            pipeline.apply_complete_pipeline()
            pipeline.extract_windowed_features_optimal()
            # Save features to a temporary DataFrame
            df = pipeline.feature_matrix
            if not isinstance(df, pd.DataFrame):
                # Convert numpy array to DataFrame with generic column names
                if isinstance(df, np.ndarray):
                    n_cols = df.shape[1] if df.ndim == 2 else 1
                    col_names = [f'feat_{i+1}' for i in range(n_cols)]
                    df = pd.DataFrame(df, columns=col_names)
                    print(f"  Converted feature_matrix to DataFrame with columns: {df.columns.tolist()}")
                else:
                    print(f"  Skipping: feature_matrix is not a DataFrame or ndarray (type: {type(df)})")
                    continue
            else:
                df = df.copy()
            if pipeline.exercise is not None:
                df['Exercise'] = int(np.squeeze(pipeline.exercise))
            all_feature_dfs.append(df)
        except Exception as e:
            print(f"  Error processing {mat_path}: {e}")
    if all_feature_dfs:
        combined_df = pd.concat(all_feature_dfs, ignore_index=True)
        default_name = "combined_emg_features.csv"
        out_csv = input(f"Enter output CSV filename (default: {default_name}): ").strip()
        if not out_csv:
            out_csv = default_name
        if not out_csv.lower().endswith('.csv'):
            out_csv += '.csv'
        combined_df.to_csv(out_csv, index=False)
        print(f"Combined features saved to: {os.path.abspath(out_csv)}")
    else:
        print("No features extracted from any files.")

def main():
    """Main function to run the EMG filtering pipeline."""
    
    # Initialize pipeline
    pipeline = EMGFilteringPipeline(fs=1000)
    
    # Load initial file
    try:
        if not pipeline.load_matlab_file():
            return
    except Exception as e:
        print(f"Error loading file: {e}")
        return
    
    # Main interaction loop
    while True:
        display_menu()
        
        # Show current filter status
        if pipeline.filter_history:
            print(f"\nCurrent filters applied: {' → '.join(pipeline.filter_history)}")
        else:
            print(f"\nNo filters applied yet")
        
        choice = get_user_choice()
        
        if choice == 0:  # Exit
            print("\nExiting EMG Filtering Pipeline. Goodbye!")
            break
            
        elif choice == 1:  # Bandpass filter
            customize = get_filter_parameters()
            if customize:
                try:
                    lowcut = float(input("Enter low cutoff frequency (default 20 Hz): ") or 20)
                    highcut = float(input("Enter high cutoff frequency (default 500 Hz): ") or 500)
                    order = int(input("Enter filter order (default 4): ") or 4)
                    pipeline.bandpass_filter(lowcut, highcut, order)
                except ValueError:
                    print("Invalid input, using defaults")
                    pipeline.bandpass_filter()
            else:
                pipeline.bandpass_filter()
        
        elif choice == 2:  # Notch filter
            customize = get_filter_parameters()
            if customize:
                try:
                    freq = float(input("Enter notch frequency (50 Hz Europe, 60 Hz US): ") or 50)
                    q = float(input("Enter Q factor (default 30): ") or 30)
                    pipeline.notch_filter(freq, q)
                except ValueError:
                    print("Invalid input, using defaults")
                    pipeline.notch_filter()
            else:
                pipeline.notch_filter()
        
        elif choice == 3:  # DC removal
            pipeline.dc_removal_filter()
        
        elif choice == 4:  # Rectification
            pipeline.rectification_filter()
        
        elif choice == 5:  # Low-pass envelope
            customize = get_filter_parameters()
            if customize:
                try:
                    cutoff = float(input("Enter cutoff frequency (default 6 Hz): ") or 6)
