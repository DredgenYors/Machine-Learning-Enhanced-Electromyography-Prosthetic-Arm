    def plot_signal_at_each_stage(self, plot_duration=10.0):
        """
        Plot the EMG signal after each stage of the filtering pipeline.
        Includes: raw, bandpass, notch, DC removal, rectification, low-pass.
        """
        if self.original_signal is None:
            print("No signal loaded for plotting.")
            return

        # Prepare signals at each stage
        signals = []
        labels = []

        # 1. Raw/original
        signals.append(self.original_signal.copy())
        labels.append("Raw/original")

        # 2. Bandpass
        from scipy.signal import butter, filtfilt, iirnotch
        nyq = 0.5 * self.fs
        low = 20.0 / nyq
        high = min(500.0 / nyq, 0.99)
        b, a = butter(4, [low, high], btype='band')
        bandpassed = filtfilt(b, a, self.original_signal, axis=0)
        signals.append(bandpassed)
        labels.append("After bandpass (20-500 Hz)")

        # 3. Notch
        b, a = iirnotch(50, 30, self.fs)
        notched = filtfilt(b, a, bandpassed, axis=0)
        signals.append(notched)
        labels.append("After notch (50 Hz)")

        # 4. DC removal
        dc_removed = notched - np.mean(notched, axis=0)
        signals.append(dc_removed)
        labels.append("After DC removal")

        # 5. Rectification
        rectified = np.abs(dc_removed)
        signals.append(rectified)
        labels.append("After rectification")

        # 6. Low-pass envelope
        normal_cutoff = min(6.0 / nyq, 0.99)
        b, a = butter(4, normal_cutoff, btype='low')
        enveloped = filtfilt(b, a, rectified, axis=0)
        signals.append(enveloped)
        labels.append("After low-pass envelope (6 Hz)")

        # Plotting
        plot_samples = int(min(plot_duration * self.fs, self.original_signal.shape[0]))
        time_vector = np.arange(plot_samples) / self.fs
        channels_all = self.selected_channels if self.selected_channels is not None else list(range(self.num_channels))
        channels_to_plot = min(4, len(channels_all))
        colors = ['blue', 'red', 'green', 'orange']

        for ch_idx in range(channels_to_plot):
            ch = channels_all[ch_idx]
            fig, axes = plt.subplots(len(signals), 1, figsize=(14, 2.5 * len(signals)))
            if len(signals) == 1:
                axes = [axes]
            for i, (sig, label) in enumerate(zip(signals, labels)):
                axes[i].plot(time_vector, sig[:plot_samples, ch], color=colors[ch_idx % len(colors)], alpha=0.8, linewidth=0.8)
                axes[i].set_title(f"{label} - Channel {ch}")
                axes[i].set_xlabel("Time (seconds)")
                axes[i].set_ylabel("Amplitude")
                axes[i].grid(True, alpha=0.3)
            plt.tight_layout()
            plt.suptitle(f"EMG Signal at Each Filtering Stage - Channel {ch}", fontsize=15, fontweight='bold')
            plt.show()
    
    def plot_rectified_filter_stages(self, plot_duration=10.0):
        """
        Plot the EMG signal at each filter stage if the original EMG is rectified.
        Stages: raw (rectified), notch, DC removal, low-pass envelope.
        """
        if self.original_signal is None:
            print("No signal loaded for plotting.")
            return

        # Detect if rectified
        orig = self.original_signal[:, self.selected_channels if self.selected_channels is not None else list(range(self.num_channels))]
        min_val = np.min(orig)
        rectified_detected = min_val >= 0 and np.mean(orig < 0) < 0.01

        if not rectified_detected:
            print("Original EMG does not appear to be rectified. Use option 21 for standard filter stages.")
            return

        signals = []
        labels = []

        # 1. Raw/original (rectified)
        signals.append(orig.copy())
        labels.append("Raw/original (rectified)")

        # 2. Notch
        from scipy.signal import butter, filtfilt, iirnotch
        b, a = iirnotch(50, 30, self.fs)
        notched = filtfilt(b, a, orig, axis=0)
        signals.append(notched)
        labels.append("After notch (50 Hz)")

        for i, (sig, label) in enumerate(zip(signals, labels)):
            print(f"{label}: min={np.min(sig):.4f}, max={np.max(sig):.4f}, mean={np.mean(sig):.4f}, std={np.std(sig):.4f}")
            if i > 0:
                diff = sig - signals[i-1]
                print(f"  Difference from previous stage: min={np.min(diff):.4f}, max={np.max(diff):.4f}, mean={np.mean(diff):.4f}, std={np.std(diff):.4f}")

        # 3. DC removal
        dc_removed = notched - np.mean(notched, axis=0)
        signals.append(dc_removed)
        labels.append("After DC removal")

        for i, (sig, label) in enumerate(zip(signals, labels)):
            print(f"{label}: min={np.min(sig):.4f}, max={np.max(sig):.4f}, mean={np.mean(sig):.4f}, std={np.std(sig):.4f}")
            if i > 0:
                diff = sig - signals[i-1]
                print(f"  Difference from previous stage: min={np.min(diff):.4f}, max={np.max(diff):.4f}, mean={np.mean(diff):.4f}, std={np.std(diff):.4f}")

        # 4. Low-pass envelope
        nyq = 0.5 * self.fs
        normal_cutoff = min(6.0 / nyq, 0.99)
        b, a = butter(4, normal_cutoff, btype='low')
        enveloped = filtfilt(b, a, dc_removed, axis=0)
        signals.append(enveloped)
        labels.append("After low-pass envelope (6 Hz)")

        for i, (sig, label) in enumerate(zip(signals, labels)):
            print(f"{label}: min={np.min(sig):.4f}, max={np.max(sig):.4f}, mean={np.mean(sig):.4f}, std={np.std(sig):.4f}")
            if i > 0:
                diff = sig - signals[i-1]
                print(f"  Difference from previous stage: min={np.min(diff):.4f}, max={np.max(diff):.4f}, mean={np.mean(diff):.4f}, std={np.std(diff):.4f}")

        # Plotting
        plot_samples = int(min(plot_duration * self.fs, orig.shape[0]))
        time_vector = np.arange(plot_samples) / self.fs
        channels_all = self.selected_channels if self.selected_channels is not None else list(range(self.num_channels))
        channels_to_plot = min(4, len(channels_all))
        colors = ['blue', 'red', 'green', 'orange']

        for ch_idx in range(channels_to_plot):
            ch = channels_all[ch_idx]
