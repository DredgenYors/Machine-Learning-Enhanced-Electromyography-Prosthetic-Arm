    def extract_rms(self, signal):
        """
        Extract Root Mean Square (RMS) feature - measure of signal magnitude.
        
        Parameters:
        signal: numpy array, EMG signal window
        
        Returns:
        float: RMS value
        """
        return np.sqrt(np.mean(signal**2))
    
    def extract_mav(self, signal):
        """
        Extract Mean Absolute Value (MAV) feature - average amplitude.
        
        Parameters:
        signal: numpy array, EMG signal window
        
        Returns:
        float: MAV value
        """
        return np.mean(np.abs(signal))
    
    def extract_zc(self, signal, threshold=0.01):
        """
        Extract Zero Crossings (ZC) feature - count of oscillations around zero.
        
        Parameters:
        signal: numpy array, EMG signal window
        threshold: float, threshold to avoid noise-induced crossings
        
        Returns:
        int: Number of zero crossings
        """
        zc_count = 0
        for i in range(len(signal) - 1):
            if abs(signal[i]) > threshold and abs(signal[i+1]) > threshold:
                if signal[i] * signal[i+1] < 0:
                    zc_count += 1
        return zc_count
    
    def extract_ssc(self, signal, threshold=0.01):
        """
        Extract Slope Sign Changes (SSC) feature - count of slope direction changes.
        
        Parameters:
        signal: numpy array, EMG signal window
        threshold: float, threshold to avoid noise-induced changes
        
        Returns:
        int: Number of slope sign changes
        """
        ssc_count = 0
        for i in range(1, len(signal) - 1):
            slope1 = signal[i] - signal[i-1]
            slope2 = signal[i+1] - signal[i]
            
            if (slope1 * slope2 < 0) and (abs(slope1) > threshold or abs(slope2) > threshold):
                ssc_count += 1
        
        return ssc_count
    
    def extract_wl(self, signal):
        """
        Extract Waveform Length (WL) feature - total signal variation over time window.
        
        Parameters:
        signal: numpy array, EMG signal window
        
        Returns:
        float: Waveform length value
        """
        return np.sum(np.abs(np.diff(signal)))

