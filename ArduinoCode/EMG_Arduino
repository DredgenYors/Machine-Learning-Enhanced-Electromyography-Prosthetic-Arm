#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

// Create the PWM driver instance
Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();

// Define constants
#define NUM_SERVOS 5
#define SERVO_MIN 150   // Minimum pulse (adjust per servo)
#define SERVO_MAX 600   // Maximum pulse (adjust per servo)
#define SERVO_DELAY 50  // Delay between updates (ms)
#define THRESH_VALUE 250 // EMG threshold

// EMG input pin
const int EMG_PIN = A3;

// Define which PCA9685 channels the servos use
int servoPins[NUM_SERVOS] = {0, 1, 2, 3, 4};  // Channels 0–4

void setup() {
  Serial.begin(9600);
  Serial.println("PCA9685 + EMG Control Start");

  pwm.begin();
  pwm.setPWMFreq(60); // Standard 60 Hz servo frequency
  delay(10);

  // Initialize servos to resting position
  for (int i = 0; i < NUM_SERVOS; i++) {
    pwm.setPWM(servoPins[i], 0, SERVO_MIN);
  }
}

void loop() {
  // Read EMG sensor value (0–1023)
  int value = analogRead(EMG_PIN);
  Serial.println(value);

  // Determine pulse value based on muscle activity
  int pulse = (value < THRESH_VALUE) ? SERVO_MIN : SERVO_MAX;

  // Move all servos to target position
  for (int i = 0; i < NUM_SERVOS; i++) {
    pwm.setPWM(servoPins[i], 0, pulse);
  }

  delay(SERVO_DELAY);
}
