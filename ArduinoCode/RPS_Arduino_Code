#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();

// Servo setup
#define NUM_SERVOS 5
#define SERVO_MIN 150   // open
#define SERVO_MAX 600   // closed
#define SERVO_DELAY 50  // ms between loops

// Updated EMG thresholds (for ~0–400 range)
#define THRESH_LOW 120
#define THRESH_HIGH 300
const int EMG_PIN = A0;

// Gesture tracking
int currentGesture = 0; // 0=paper, 1=scissors, 2=rock
unsigned long lastGestureTime = 0;
#define HOLD_TIME_MS 1500  // hold gesture for at least 1.5 s

// Finger mapping
int servoPins[NUM_SERVOS] = {0, 1, 2, 3, 4}; // pinky, ring, middle, index, thumb

void setup() {
  Serial.begin(9600);
  Serial.println("Rock-Paper-Scissors Prosthetic (Rescaled Thresholds)");

  pwm.begin();
  pwm.setPWMFreq(60);
  delay(10);

  // Start open hand
  setPaper();
}

void loop() {
  int emgValue = analogRead(EMG_PIN);
  Serial.println(emgValue);

  // Skip gesture changes if hold period not finished
  if (millis() - lastGestureTime < HOLD_TIME_MS) {
    delay(SERVO_DELAY);
    return;
  }

  // ROCK
  if (emgValue > THRESH_HIGH && currentGesture != 2) {
    setRock();
    currentGesture = 2;
    lastGestureTime = millis();
    Serial.println("Gesture: ROCK ✊");
  }

  // SCISSORS
  else if (emgValue > THRESH_LOW && emgValue <= THRESH_HIGH && currentGesture != 1) {
    setScissors();
    currentGesture = 1;
    lastGestureTime = millis();
    Serial.println("Gesture: SCISSORS ✌️");
  }

  // PAPER
  else if (emgValue <= THRESH_LOW && currentGesture != 0) {
    setPaper();
    currentGesture = 0;
    lastGestureTime = millis();
    Serial.println("Gesture: PAPER ✋");
  }

  delay(SERVO_DELAY);
}

// ===================== Gesture Functions ======================

void setPaper() {
  for (int i = 0; i < NUM_SERVOS; i++) {
    pwm.setPWM(servoPins[i], 0, SERVO_MIN); // open
  }
}

void setScissors() {
  pwm.setPWM(servoPins[0], 0, SERVO_MAX); // pinky closed
  pwm.setPWM(servoPins[1], 0, SERVO_MAX); // ring closed
  pwm.setPWM(servoPins[2], 0, SERVO_MIN); // middle open
  pwm.setPWM(servoPins[3], 0, SERVO_MIN); // index open
  pwm.setPWM(servoPins[4], 0, SERVO_MAX); // thumb closed
}

void setRock() {
  for (int i = 0; i < NUM_SERVOS; i++) {
    pwm.setPWM(servoPins[i], 0, SERVO_MAX); // closed
  }
}
